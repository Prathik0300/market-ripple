{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-preview",
      "runtimeExecutable": "/opt/homebrew/bin/python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "out/preview"
      ],
      "port": 8765
    },
    {
      "name": "web-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "mcp-test-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/scripts/mcp-test-server.mjs"
      ],
      "port": 8799
    },
    {
      "name": "cas-reader",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "web/api/cas.py"
      ],
      "port": 8797
    },
    {
      "name": "web-app-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "web",
        "next",
        "dev",
        "web",
        "-p",
        "3002"
      ],
      "env": {
        "NEXT_DIST_DIR": ".next-alt"
      },
      "port": 3002,
      "url": "http://localhost:3002"
    }
  ]
}