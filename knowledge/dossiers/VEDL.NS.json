: "likely", "hidden": false, "t": 3.1, "node": null, "push": 0, "events": []}]}, "events": [{"id": "daea1b9845d9", "ts": "2026-10-19T16:32:50Z", "title": "Houthis claim strikes on Saudi Shaybah oilfield, Aramco Yanbu site and Riyadh and Abha airports", "summary": "Yemen's Houthis said they attacked Saudi energy, airport and military targets including the Shaybah oilfield, an Aramco site in Yanbu, King Khalid airport in Riyadh and Abha airport; Saudi damage was not confirmed in the report.", "url": "https://www.financialjuice.com/News/9811703/Yemens-Houthis-Carried-out-several-attacks-against-Saudi-Arabia-energy-airports-and-military-targets-including-Aramco-site-in-Yanbu.aspx?xy=rss", "source": "FinancialJuice", "scale": "notable", "category": "conflict", "region": "Middle East", "c": 0.16, "via": "oil"}, {"id": "8456e147321e", "ts": "2026-10-17T12:41:00Z", "title": "IRGC says a second supertanker hit a naval mine in Hormuz and declares the strait closed", "summary": "Iran's IRGC said a second supertanker struck a naval mine on an unauthorized Strait of Hormuz route and declared the strait closed after the tanker hits; the vessels were not identified and the US says the strait is under US and partner control. The claims are unverified.", "url": "https://news.google.com/rss/articles/CBMiswFBVV95cUxQWDN2N3cwX3M5Y2N0Y05JXy1QNEc2cU5xVmhJb3NrUTdjbHliZnlmS1ZLUUNsT0pGTUtrVDhhWUc4RTJ4Nk04d1pDRlE4WjBrRHVreFhzY2tvYUxCSHVHOGxEanUtbXZxSXZJQ1pOdDhNNFpEa0pid2dSci1lNE9LdHNFd05tc0ZFRkZ4SE1VZFEyMTFpZkZHNHFDSXVOU3VfdEZKZkdoQ09mbXNJdFE0MHFLYw?oc=5", "source": "Anadolu Agency", "scale": "notable", "category": "conflict", "region": "Middle East", "c": 0.096, "via": "oil"}, {"id": "5e80450db472", "ts": "2026-10-17T09:00:00Z", "title": "NBC: attacks on ships around the Strait of Hormuz reach record highs as Iran steps up strikes", "summary": "NBC News reported attacks on vessels around Hormuz have reached record levels with little US response; Reuters-cited tracking had already counted at least 12 tanker attacks in the week to Oct 5, the most since the war began.", "url": "https://news.google.com/rss/articles/CBMiqwFBVV95cUxQRkpjbHhhcjBfM1pXOUVuTE5rZ0lrMWJTUFBrZXYxY2FhcEtKWEJyR0lGSjBIb05pNTRfMW92elFEUlVHc3JjdzAwMmdWQTlLdmdZY0R4NGJOd3dUbEF1M3FCUVZRa1RfVjY0NnVxR013emZQTHMwSUFpNG5XU2RZendpNzd0LWZ4ZE5LakMycUEwMG9MQlZKQW82QTB4c0w0SV9QNTkwVlJIYnM?oc=5", "source": "NBC News", "scale": "notable", "category": "conflict", "region": "Middle East", "c": 0.093, "via": "oil"}, {"id": "0c2ba442ab2f", "ts": "2026-10-17T06:28:00Z", "title": "UKMTO: tanker hit by unidentified projectile northeast of Saudi Arabia's Jubail", "summary": "UKMTO reported a tanker was struck by an unidentified projectile northeast of Jubail on Friday; the crew was safe and evacuated. It extends Gulf shipping attacks beyond the Strait of Hormuz into Saudi waters.", "url": "https://www.financialjuice.com/News/9809790/UKMTO-Tanker-hit-by-unidentified-projectile-northeast-of-Saudi-Arabias-Jubail-on-Friday-crew-safe-and-evacuated.aspx?xy=rss", "source": "FinancialJuice", "scale": "notable", "category": "conflict", "region": "Middle East", "c": 0.091, "via": "oil"}, {"id": "cea346a0c667", "ts": "2026-10-18T11:20:00Z", "title": "Ukraine launches more than 1,000 drones at Russia, setting St Petersburg oil terminal and depot ablaze", "summary": "Russia's defence ministry said it downed about 1,015 Ukrainian drones overnight, one of the largest attacks of the war; fires hit the St Petersburg oil terminal, the Ruchyi oil depot and a VK data centre, with one person killed. Russia answered with about 300 drones.", "url": "https://abcnews.com/International/ukraine-targets-russia-1000-drones-striking-oil-terminal/story?id=137358203", "source": "ABC News", "scale": "notable", "category": "conflict", "region": "Russia", "c": 0.091, "via": "oil"}, {"id": "892e48d4ee25", "ts": "2026-10-17T01:39:00Z", "title": "IRGC says a supertanker caught fire after hitting a naval mine on an 'unauthorized' Hormuz route", "summary": "Iran's Revolutionary Guards said an oil tanker ignited after striking a naval mine while using what they called an unauthorized route through the Strait of Hormuz; the vessel was not identified and the claim was not independently verified. It follows similar IRGC claims on Oct 10 (supertanker) and Oct 14 (container ship).", "url": "https://www.aljazeera.com/news/liveblog/2026/10/17/draft-2", "source": "Al Jazeera / FinancialJuice", "scale": "notable", "category": "conflict", "region": "Middle East", "c": 0.087, "via": "oil"}, {"id": "7cccf2362fe4", "ts": "2026-10-19T18:33:00Z", "title": "Tasnim: Yemeni drone attacks on Dammam halt airport activity", "summary": "Iran's Tasnim News reported Yemeni drone attacks on Dammam in Saudi Arabia's Eastern Province and said activity at Dammam airport was halted; not independently confirmed.", "url": "https://www.financialjuice.com/News/9811830/Yemeni-drone-attacks-on-Dammam-Saudi-Arabia-Dammam-airport-activity-halted---Tasnim-News.aspx?xy=rss", "source": "FinancialJuice / Tasnim", "scale": "minor", "category": "conflict", "region": "Middle East", "c": 0.082, "via": "oil"}, {"id": "abe9106c05b2", "ts": "2026-10-16T18:09:42Z", "title": "Indian official says crude tanker targeted by missile in Strait of Hormuz", "summary": "An Indian shipping official said a crude oil tanker was targeted by a missile in the Strait of Hormuz on Friday and also referred to the recent Romania-linked tanker incident; it adds to this week's string of attacks on Gulf shipping.", "url": "https://news.google.?oc=5", "source": "Newsquawk", "scale": "notable", "category": "conflict", "region": "Middle East", "c": 0.081, "via": "oil"}, {"id": "69db32cf9be0", "ts": "2026-10-19T12:36:09Z", "title": "Tehran seeks to punish Trump in the midterms with oil price pain, Iranian officials say", "summary": "The Washington Post reported that Iranian officials said Tehran aims to keep oil prices high ahead of the US midterm elections.", "url": "https://news.